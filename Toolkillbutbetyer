    titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
    titleLbl.Parent = notif
    
    -- Message
    local msgLbl = Instance.new("TextLabel")
    msgLbl.Size = UDim2.new(1, -55, 0, 30)
    msgLbl.Position = UDim2.new(0, 45, 0, 30)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Text = message
    msgLbl.TextColor3 = Color3.fromRGB(200, 195, 220)
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 11
    msgLbl.TextWrapped = true
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextYAlignment = Enum.TextYAlignment.Top
    msgLbl.Parent = notif
    
    -- Timer bar
    local timerBar = Instance.new("Frame")
    timerBar.Size = UDim2.new(1, -20, 0, 3)
    timerBar.Position = UDim2.new(0, 10, 1, -8)
    timerBar.BackgroundColor3 = accent
    timerBar.BorderSizePixel = 0
    timerBar.Parent = notif
    
    local tbCorner2 = Instance.new("UICorner")
    tbCorner2.CornerRadius = UDim.new(0, 2)
    tbCorner2.Parent = timerBar
    
    -- Slide-in animasyonu
    notif.Position = UDim2.new(1, 50, 0, 0)
    notif.BackgroundTransparency = 1
    TweenService:Create(notif, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 0.05
    }):Play()
    
    -- Timer bar animasyonu
    TweenService:Create(timerBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 3)
    }):Play()
    
    -- Pulse glow
    task.spawn(function()
        task.wait(0.4)
        TweenService:Create(nStroke, TweenInfo.new(0.4), { Transparency = 0 }):Play()
        task.wait(0.4)
        TweenService:Create(nStroke, TweenInfo.new(0.8), { Transparency = 0.5 }):Play()
    end)
    
    -- Otomatik dismiss
    task.delay(duration, function()
        if not notif.Parent then return end
        TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 50, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        task.wait(0.35)
        if notif.Parent then notif:Destroy() end
    end)
end

-- ==================== HELPER ====================
local function FindPlayer(name)
    if type(name) ~= "string" or name == "" then return nil end
    local lower = name:lower()
    if lower == "random" then
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= plr and p.Character then table.insert(list, p) end
        end
        if #list == 0 then return nil end
        return list[math.random(1, #list)]
    end
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= plr and (v.Name:lower():sub(1, #lower) == lower or
           v.DisplayName:lower():sub(1, #lower) == lower) then
            return v
        end
    end
end

local function sendChat(msg)
    pcall(function()
        game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync(msg)
    end)
end

-- ==================== TOOL ====================
local function getTool()
    local char = plr.Character
    if not char then return nil end
    local Tool = plr.Backpack:FindFirstChildOfClass("Tool") 
              or char:FindFirstChildOfClass("Tool")
    if not Tool then
        Tool = Instance.new("Tool")
        Tool.Name = "KAIOD_Tool"
        Tool.CanBeDropped = false
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(1, 1, 1)
        handle.CanCollide = false
        handle.Massless = true
        handle.Transparency = 1
        handle.Parent = Tool
        Tool.Parent = plr.Backpack
        task.wait(0.15)
    end
    return Tool
end

-- ==================== ATTACK ====================
local function beginAttack(targetPlayer)
    if not targetPlayer then return nil end
    local char = plr.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local starta = hrp.CFrame

    local tChar = targetPlayer.Character
    if not tChar then return nil end
    local tHRP = tChar:FindFirstChild("HumanoidRootPart")
    if not tHRP then return nil end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    pcall(function() hum:UnequipTools() end)
    
    local Tool = getTool()
    if not Tool then return nil end
    
    local animate = char:FindFirstChild("Animate")
    if animate then pcall(function() animate.Disabled = true end) end
    
    local newHum = hum:Clone()
    pcall(function() hum:Destroy() end)
    newHum.Parent = char
    Tool.Parent = char
    pcall(function() newHum:ChangeState(15) end)
    
    local handle = Tool:FindFirstChild("Handle")
    if handle and firetouchinterest then
        pcall(function()
            firetouchinterest(tHRP, handle, 0)
            task.wait()
            firetouchinterest(tHRP, handle, 1)
        end)
    end
    
    task.wait(0.5)
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    local freshTHRP = tChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not freshTHRP then return nil end
    return starta, freshTHRP, myRoot
end

-- ==================== HIGHLIGHT ====================
local function clearHighlight()
    if State.highlight then
        pcall(function() State.highlight:Destroy() end)
        State.highlight = nil
    end
end

local function highlightCharacter(char, color)
    clearHighlight()
    if not char or not char.Parent then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color or Color3.fromRGB(255, 50, 100)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    State.highlight = hl
end

