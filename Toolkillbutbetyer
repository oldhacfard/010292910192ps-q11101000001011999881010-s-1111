-- ==================== MANUEL DRAG (bug fix) ====================
local function onDragStart(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local pos = input.Position
    local framePos = frame.AbsolutePosition
    if pos.Y - framePos.Y <= 48 then
        State.isDragging = true
        State.dragStart = Vector2.new(pos.X, pos.Y)
        State.frameStart = UDim2.new(frame.Position.X.Scale, frame.Position.X.Offset,
                                      frame.Position.Y.Scale, frame.Position.Y.Offset)
    end
end

local function onDragMove(input)
    if not State.isDragging then return end
    local pos = input.Position
    local delta = Vector2.new(pos.X - State.dragStart.X, pos.Y - State.dragStart.Y)
    frame.Position = UDim2.new(
        State.frameStart.X.Scale, State.frameStart.X.Offset + delta.X,
        State.frameStart.Y.Scale, State.frameStart.Y.Offset + delta.Y
    )
end

local function onDragEnd(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
       or input.UserInputType == Enum.UserInputType.Touch then
        State.isDragging = false
    end
end

titleBar.InputBegan:Connect(onDragStart)
UserInputService.InputChanged:Connect(onDragMove)
UserInputService.InputEnded:Connect(onDragEnd)

