-- Oyuncu seç (raycast) - TOUCH + MOUSE
local function trySelectPlayer(screenPos)
    local cam = workspace.CurrentCamera
    local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = {gui}
    if plr.Character then table.insert(filter, plr.Character) end
    params.FilterDescendantsInstances = filter
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if result and result.Instance then
        local hitChar = result.Instance:FindFirstAncestorOfClass("Model")
        if hitChar then
            local hitPlayer = Players:GetPlayerFromCharacter(hitChar)
            if hitPlayer and hitPlayer ~= plr then
                targetBox.Text = hitPlayer.Name
                updateInfoCard(hitPlayer)
                Notify("Hedef Seçildi", hitPlayer.DisplayName, "success", 2)
                
                State.touchMode = false
                touchBtn.BackgroundColor3 = Color3.fromRGB(80, 40, 160)
                touchBtn.Text = "👆 TIKLA"
                statusLabel.Text = "🎯 Hedef seçildi!"
                statusLabel.TextColor3 = Color3.fromRGB(120, 255, 150)
                return true
            end
        end
    end
    return false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not State.touchMode then return end
    if State.isDragging then return end
    
    local isTap = input.UserInputType == Enum.UserInputType.MouseButton1 
                or input.UserInputType == Enum.UserInputType.Touch
    if not isTap then return end
    
    local pos
    if input.UserInputType == Enum.UserInputType.Touch then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    else
        pos = UserInputService:GetMouseLocation()
    end
    
    trySelectPlayer(pos)
end)

